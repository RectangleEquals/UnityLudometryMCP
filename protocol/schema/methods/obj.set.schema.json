{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/obj.set.schema.json",
  "title": "obj.set",
  "description": "Sets a member value.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "ObjSetParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "path": {
          "$ref": "../common/member-path.schema.json"
        },
        "value": {}
      },
      "required": [
        "target",
        "path",
        "value"
      ]
    },
    "result": {
      "title": "ObjSetResult",
      "type": "object",
      "properties": {
        "previous": {
          "$ref": "../common/value.schema.json"
        },
        "current": {
          "$ref": "../common/value.schema.json"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "previous",
        "current",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
