{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/hooks.clear.schema.json",
  "title": "hooks.clear",
  "description": "Removes this connection's hooks, or all hooks.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "HooksClearParams",
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "enum": [
            "connection",
            "all"
          ]
        }
      }
    },
    "result": {
      "title": "HooksClearResult",
      "type": "object",
      "properties": {
        "removed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "removed"
      ]
    }
  }
}
