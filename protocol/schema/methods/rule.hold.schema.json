{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/rule.hold.schema.json",
  "title": "rule.hold",
  "description": "Keeps a rule-held pause alive past the pause watchdog.",
  "x-method": {
    "thread": "any",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "RuleHoldParams",
      "type": "object",
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "extendMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ruleId"
      ]
    },
    "result": {
      "title": "RuleHoldResult",
      "type": "object",
      "properties": {
        "heldUntilRealtimeMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "heldUntilRealtimeMs"
      ]
    }
  }
}
