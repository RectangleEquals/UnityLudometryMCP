{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/input.end.schema.json",
  "title": "input.end",
  "description": "Ends a session: the overlay shows that control ends (a short countdown), then everything virtual is released.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "InputEndParams",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The session, from `input.begin`."
        },
        "countdownMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Notice before control ends (default 3000; 0 ends at once)."
        }
      },
      "required": [
        "sessionId"
      ]
    },
    "result": {
      "title": "InputEndResult",
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "description": "How long the session was open."
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "durationMs",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
