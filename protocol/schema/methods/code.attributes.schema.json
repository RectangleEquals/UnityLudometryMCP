{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/code.attributes.schema.json",
  "title": "code.attributes",
  "description": "Every member carrying an attribute (decoded, never instantiated).",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "CodeAttributesParams",
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "assembly",
              "type",
              "method",
              "field",
              "property",
              "event",
              "parameter"
            ]
          }
        }
      },
      "required": [
        "attribute"
      ]
    },
    "result": {
      "title": "CodeAttributesResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "title": "AttributeUsage",
            "type": "object",
            "properties": {
              "target": {
                "$ref": "../common/anchor.schema.json"
              },
              "targetKind": {
                "type": "string"
              },
              "attribute": {
                "$ref": "../methods/code.assembly.schema.json#/$defs/result/properties/attributes/items"
              }
            },
            "required": [
              "target",
              "targetKind",
              "attribute"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
