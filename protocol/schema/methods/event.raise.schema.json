{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/event.raise.schema.json",
  "title": "event.raise",
  "description": "Invokes an event's backing delegate (to trigger its listeners).",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "EventRaiseParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "event": {
          "$ref": "../common/anchor.schema.json"
        },
        "args": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "event"
      ]
    },
    "result": {
      "title": "EventRaiseResult",
      "type": "object",
      "properties": {
        "listenersInvoked": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "listenersInvoked",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
