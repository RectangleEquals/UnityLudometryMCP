{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/hook.hits.schema.json",
  "title": "hook.hits",
  "description": "Recorded hits of a hook (pull).",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "HookHitsParams",
      "type": "object",
      "properties": {
        "hookId": {
          "type": "string",
          "minLength": 1
        },
        "sinceSeq": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to return."
        }
      },
      "required": [
        "hookId"
      ]
    },
    "result": {
      "title": "HookHitsResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/instrumentation-record.schema.json"
          }
        },
        "nextSeq": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "items",
        "nextSeq",
        "dropped"
      ]
    }
  }
}
