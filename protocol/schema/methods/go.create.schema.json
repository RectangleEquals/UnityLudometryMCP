{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/go.create.schema.json",
  "title": "go.create",
  "description": "Creates a GameObject.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "GoCreateParams",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "$ref": "../common/target.schema.json"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "../common/anchor.schema.json"
          }
        },
        "scene": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "result": {
      "title": "GoCreateResult",
      "type": "object",
      "properties": {
        "descriptor": {
          "$ref": "../common/handle-descriptor.schema.json"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "descriptor",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
