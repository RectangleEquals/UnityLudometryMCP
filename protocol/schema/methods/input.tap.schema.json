{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/input.tap.schema.json",
  "title": "input.tap",
  "description": "Presses one input and releases it after holdMs or holdFrames (default one frame); completes after the release.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "InputTapParams",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The session, from `input.begin`."
        },
        "press": {
          "$ref": "../common/input.schema.json#/$defs/press"
        },
        "layer": {
          "$ref": "../common/input.schema.json#/$defs/layer"
        }
      },
      "required": [
        "sessionId",
        "press"
      ]
    },
    "result": {
      "title": "InputTapResult",
      "type": "object",
      "properties": {
        "layer": {
          "$ref": "../common/input.schema.json#/$defs/layer"
        },
        "downFrame": {
          "type": "integer",
          "minimum": 0
        },
        "upFrame": {
          "type": "integer",
          "minimum": 0
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "layer",
        "downFrame",
        "upFrame",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
