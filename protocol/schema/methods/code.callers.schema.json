{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/code.callers.schema.json",
  "title": "code.callers",
  "description": "Caller tree of a method among loaded assemblies (runtime IL index).",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "CodeCallersParams",
      "type": "object",
      "properties": {
        "method": {
          "$ref": "../common/anchor.schema.json"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "method"
      ]
    },
    "result": {
      "title": "CodeCallersResult",
      "type": "object",
      "properties": {
        "root": {
          "$ref": "../common/anchor.schema.json"
        },
        "items": {
          "type": "array",
          "items": {
            "title": "CallTreeNode",
            "type": "object",
            "properties": {
              "method": {
                "$ref": "../common/anchor.schema.json"
              },
              "opcode": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/result/properties/items/items"
                }
              }
            },
            "required": [
              "method"
            ]
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Limits that apply to this result (e.g. virtual calls give the declared target; reflection isn't visible)."
        }
      },
      "required": [
        "root",
        "items"
      ]
    }
  }
}
