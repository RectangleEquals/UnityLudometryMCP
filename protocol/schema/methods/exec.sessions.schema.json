{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/exec.sessions.schema.json",
  "title": "exec.sessions",
  "description": "Snippet sessions and their variables.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "ExecSessionsParams",
      "type": "object",
      "properties": {}
    },
    "result": {
      "title": "ExecSessionsResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "title": "ExecSession",
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "UTC timestamp, ISO 8601."
              },
              "runs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "name",
              "variables",
              "createdAt",
              "runs"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
