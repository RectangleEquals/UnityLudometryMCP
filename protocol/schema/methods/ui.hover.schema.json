{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/ui.hover.schema.json",
  "title": "ui.hover",
  "description": "Moves the pointer onto (or, with leave, off) an element through the EventSystem, so hover-only elements (tooltips, previews) react as for a real pointer.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true,
    "requires": [
      "module:ugui"
    ]
  },
  "$defs": {
    "params": {
      "title": "UiHoverParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "leave": {
          "type": "boolean",
          "description": "Send pointer exit instead of enter."
        }
      },
      "required": [
        "target"
      ]
    },
    "result": {
      "title": "UiHoverResult",
      "type": "object",
      "properties": {
        "handled": {
          "type": "boolean"
        },
        "via": {
          "type": "string"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "handled",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
