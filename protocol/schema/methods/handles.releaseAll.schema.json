{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/handles.releaseAll.schema.json",
  "title": "handles.releaseAll",
  "description": "Releases every handle not bound to a variable.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "HandlesReleaseAllParams",
      "type": "object",
      "properties": {
        "includeVariables": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "title": "HandlesReleaseAllResult",
      "type": "object",
      "properties": {
        "released": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "released"
      ]
    }
  }
}
