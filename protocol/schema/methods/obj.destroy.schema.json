{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/obj.destroy.schema.json",
  "title": "obj.destroy",
  "description": "Destroys a Unity object (`Object.Destroy` or `DestroyImmediate`).",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "ObjDestroyParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "immediate": {
          "type": "boolean"
        }
      },
      "required": [
        "target"
      ]
    },
    "result": {
      "title": "ObjDestroyResult",
      "type": "object",
      "properties": {
        "destroyed": {
          "type": "boolean"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "destroyed",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
