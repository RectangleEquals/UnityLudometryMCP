{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/hook.list.schema.json",
  "title": "hook.list",
  "description": "Active hooks.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "HookListParams",
      "type": "object",
      "properties": {}
    },
    "result": {
      "title": "HookListResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "title": "HookInfo",
            "type": "object",
            "properties": {
              "hookId": {
                "type": "string"
              },
              "method": {
                "$ref": "../common/anchor.schema.json"
              },
              "hits": {
                "type": "integer",
                "minimum": 0
              },
              "dropped": {
                "type": "integer",
                "minimum": 0
              },
              "sample": {
                "type": "integer",
                "minimum": 1
              },
              "owner": {
                "type": "string"
              },
              "persistent": {
                "type": "boolean"
              }
            },
            "required": [
              "hookId",
              "method",
              "hits",
              "dropped",
              "sample",
              "owner",
              "persistent"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
