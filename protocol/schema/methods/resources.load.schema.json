{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/resources.load.schema.json",
  "title": "resources.load",
  "description": "Loads an asset from a Resources folder.",
  "x-method": {
    "thread": "main",
    "minMode": "ReadOnly+Load",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "ResourcesLoadParams",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ]
    },
    "result": {
      "title": "ResourcesLoadResult",
      "type": "object",
      "properties": {
        "descriptor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../common/handle-descriptor.schema.json"
            }
          ]
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "descriptor",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
