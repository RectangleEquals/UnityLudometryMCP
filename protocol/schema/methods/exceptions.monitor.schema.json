              }
            }
          }
        }
      },
      "required": [
        "enabled"
      ]
    },
    "result": {
      "title": "ExceptionsMonitorResult",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "firstChance": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "firstChance"
      ]
    }
  }
}
