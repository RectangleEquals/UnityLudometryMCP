{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/value.expand.schema.json",
  "title": "value.expand",
  "description": "Expands a redaction stub by its ref: a deeper view, a list/dict range, or the full string. Reads the current value.",
  "x-method": {
    "thread": "main",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "ValueExpandParams",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "$ref": "../common/view.schema.json"
        },
        "range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "ref"
      ]
    },
    "result": {
      "title": "ValueExpandResult",
      "type": "object",
      "properties": {
        "value": {
          "$ref": "../common/value.schema.json"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "value",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
