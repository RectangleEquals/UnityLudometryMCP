{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/go.setActive.schema.json",
  "title": "go.setActive",
  "description": "Activates or deactivates a GameObject.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "GoSetActiveParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "active": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "active"
      ]
    },
    "result": {
      "title": "GoSetActiveResult",
      "type": "object",
      "properties": {
        "previous": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "previous",
        "active",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
