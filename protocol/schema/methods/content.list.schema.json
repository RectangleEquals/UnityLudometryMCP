{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/content.list.schema.json",
  "title": "content.list",
  "description": "Loaded objects of a type with type-specific summaries.",
  "x-method": {
    "thread": "main",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "ContentListParams",
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "../common/anchor.schema.json"
            }
          ],
          "description": "Full type name or anchor."
        },
        "nameRegex": {
          "type": "string"
        },
        "includeHidden": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to return."
        },
        "cursor": {
          "type": "string",
          "description": "Continuation cursor from a previous page (session-scoped, expires after 10 minutes)."
        }
      },
      "required": [
        "type"
      ]
    },
    "result": {
      "title": "ContentListResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "title": "ContentItem",
            "type": "object",
            "properties": {
              "h": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "type": {
                "$ref": "../common/anchor.schema.json"
              },
              "instanceId": {
                "type": "integer"
              },
              "summary": {
                "type": "object"
              },
              "locator": {
                "$ref": "../common/locator.schema.json"
              }
            },
            "required": [
              "h",
              "name",
              "type",
              "instanceId",
              "summary",
              "locator"
            ]
          }
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cursor for the next page; null when this is the last page."
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Total count when known cheaply; null otherwise."
        }
      },
      "required": [
        "items",
        "cursor",
        "total"
      ]
    }
  }
}
