{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/probe.result.schema.json",
  "title": "probe.result",
  "description": "Collects the result of a probe that waited for gameplay (`needs_trigger`).",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "ProbeResultParams",
      "type": "object",
      "properties": {
        "probeId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "probeId"
      ]
    },
    "result": {
      "$ref": "../common/probe.schema.json#/$defs/result"
    }
  }
}
