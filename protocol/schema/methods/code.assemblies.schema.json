{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/code.assemblies.schema.json",
  "title": "code.assemblies",
  "description": "Loaded assemblies with MVIDs, on-disk file hashes and load details.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "CodeAssembliesParams",
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Assembly-name globs."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Assembly-name globs."
        }
      }
    },
    "result": {
      "title": "CodeAssembliesResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/assembly-summary.schema.json"
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
