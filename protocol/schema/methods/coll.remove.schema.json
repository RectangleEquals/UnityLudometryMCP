{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/coll.remove.schema.json",
  "title": "coll.remove",
  "description": "Removes an item (by index, key or value) from a collection at a member path.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "CollRemoveParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "path": {
          "$ref": "../common/member-path.schema.json"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "key": {},
        "value": {}
      },
      "required": [
        "target",
        "path"
      ],
      "oneOf": [
        {
          "required": [
            "index"
          ]
        },
        {
          "required": [
            "key"
          ]
        },
        {
          "required": [
            "value"
          ]
        }
      ]
    },
    "result": {
      "title": "CollRemoveResult",
      "type": "object",
      "properties": {
        "removed": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "removed",
        "count",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
