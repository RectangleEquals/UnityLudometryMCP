{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/coll.count.schema.json",
  "title": "coll.count",
  "description": "Count of a collection without materializing it.",
  "x-method": {
    "thread": "main",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "CollCountParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        },
        "path": {
          "$ref": "../common/member-path.schema.json"
        }
      },
      "required": [
        "target",
        "path"
      ]
    },
    "result": {
      "title": "CollCountResult",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "count",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
