{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/go.instantiate.schema.json",
  "title": "go.instantiate",
  "description": "Clones an object (`Object.Instantiate`).",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "GoInstantiateParams",
      "type": "object",
      "properties": {
        "original": {
          "$ref": "../common/target.schema.json"
        },
        "parent": {
          "$ref": "../common/target.schema.json"
        },
        "position": {
          "$ref": "../common/value.schema.json"
        },
        "rotation": {
          "$ref": "../common/value.schema.json"
        }
      },
      "required": [
        "original"
      ]
    },
    "result": {
      "title": "GoInstantiateResult",
      "type": "object",
      "properties": {
        "descriptor": {
          "$ref": "../common/handle-descriptor.schema.json"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "descriptor",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
