{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/handles.list.schema.json",
  "title": "handles.list",
  "description": "Live handles with their descriptors (most recently used first).",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "HandlesListParams",
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to return."
        },
        "cursor": {
          "type": "string",
          "description": "Continuation cursor from a previous page (session-scoped, expires after 10 minutes)."
        }
      }
    },
    "result": {
      "title": "HandlesListResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/handle-descriptor.schema.json"
          }
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cursor for the next page; null when this is the last page."
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Total count when known cheaply; null otherwise."
        }
      },
      "required": [
        "items",
        "cursor",
        "total"
      ]
    }
  }
}
