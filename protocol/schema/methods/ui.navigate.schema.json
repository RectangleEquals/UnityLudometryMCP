{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/ui.navigate.schema.json",
  "title": "ui.navigate",
  "description": "Moves the selection like a gamepad or the arrow keys: the selected element's navigation, through the EventSystem.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true,
    "requires": [
      "module:ugui"
    ]
  },
  "$defs": {
    "params": {
      "title": "UiNavigateParams",
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        }
      },
      "required": [
        "direction"
      ]
    },
    "result": {
      "title": "UiNavigateResult",
      "type": "object",
      "properties": {
        "moved": {
          "type": "boolean",
          "description": "Whether the selection changed."
        },
        "selected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "The selected element afterwards, or null when nothing is selected."
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "moved",
        "selected",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
