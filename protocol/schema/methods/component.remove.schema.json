{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/component.remove.schema.json",
  "title": "component.remove",
  "description": "Removes (destroys) a component.",
  "x-method": {
    "thread": "main",
    "minMode": "Full",
    "job": false,
    "mutating": true
  },
  "$defs": {
    "params": {
      "title": "ComponentRemoveParams",
      "type": "object",
      "properties": {
        "target": {
          "$ref": "../common/target.schema.json"
        }
      },
      "required": [
        "target"
      ]
    },
    "result": {
      "title": "ComponentRemoveResult",
      "type": "object",
      "properties": {
        "removed": {
          "type": "boolean"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "description": "Frame of the read."
        },
        "realtimeMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the game started."
        }
      },
      "required": [
        "removed",
        "frame",
        "realtimeMs"
      ]
    }
  }
}
