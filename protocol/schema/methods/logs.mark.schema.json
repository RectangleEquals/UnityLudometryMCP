{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/logs.mark.schema.json",
  "title": "logs.mark",
  "description": "Inserts a marker entry, so everything since the mark is easy to fetch.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "LogsMarkParams",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label"
      ]
    },
    "result": {
      "title": "LogsMarkResult",
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "seq"
      ]
    }
  }
}
