{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/screenshot.camera.schema.json",
  "title": "screenshot.camera",
  "description": "Renders one camera into a texture and writes a PNG (no screen-space UI).",
  "x-method": {
    "thread": "main",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "ScreenshotCameraParams",
      "type": "object",
      "properties": {
        "camera": {
          "$ref": "../common/target.schema.json"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path"
      ]
    },
    "result": {
      "$ref": "../common/capture.schema.json#/$defs/result"
    }
  }
}
