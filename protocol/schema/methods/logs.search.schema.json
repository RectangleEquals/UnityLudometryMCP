{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/methods/logs.search.schema.json",
  "title": "logs.search",
  "description": "Matching entries within the buffer.",
  "x-method": {
    "thread": "any",
    "minMode": "ReadOnly",
    "job": false,
    "mutating": false
  },
  "$defs": {
    "params": {
      "title": "LogsSearchParams",
      "type": "object",
      "properties": {
        "regex": {
          "type": "string",
          "minLength": 1
        },
        "fromSeq": {
          "type": "integer",
          "minimum": 0
        },
        "toSeq": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of items to return."
        }
      },
      "required": [
        "regex"
      ]
    },
    "result": {
      "title": "LogsSearchResult",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/log-entry.schema.json"
          }
        }
      },
      "required": [
        "items"
      ]
    }
  }
}
