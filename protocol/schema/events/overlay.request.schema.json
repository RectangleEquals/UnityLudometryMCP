{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/events/overlay.request.schema.json",
  "title": "overlay.request",
  "description": "The user pressed a cross-tool button (only shown when the client declared the capability); the client fulfils it.",
  "$defs": {
    "params": {
      "title": "OverlayRequestEventParams",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "openInStaticTool",
            "showSource",
            "showAssetOrigin"
          ]
        },
        "target": {
          "$ref": "../common/handle-descriptor.schema.json"
        },
        "anchor": {
          "$ref": "../common/anchor.schema.json"
        },
        "locator": {
          "$ref": "../common/locator.schema.json"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
