{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/events/log.schema.json",
  "title": "log",
  "description": "Batched log entries (Unity, loader, agent), filtered by the subscription (`minLevel`, `sources`). Also pullable with `logs.tail`.",
  "$defs": {
    "params": {
      "title": "LogEventParams",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common/log-entry.schema.json"
          }
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Items dropped under back-pressure since the previous batch."
        }
      },
      "required": [
        "items",
        "dropped"
      ]
    }
  }
}
