{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/events/watch.changes.schema.json",
  "title": "watch.changes",
  "description": "Batched value changes of watches. Also pullable with `watch.changes`.",
  "$defs": {
    "params": {
      "title": "WatchChangesEventParams",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../methods/watch.changes.schema.json#/$defs/result/properties/items/items"
          }
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Items dropped under back-pressure since the previous batch."
        }
      },
      "required": [
        "items",
        "dropped"
      ]
    }
  }
}
