{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/common/job.schema.json",
  "description": "Long-running operations return a job reference immediately; progress and results are read with `job.get` / `job.wait` or the `job.progress` / `job.finished` events.",
  "$defs": {
    "jobRef": {
      "title": "JobRef",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "Job kind label, e.g. `survey`, `il.index`, `trace`."
        }
      },
      "required": [
        "jobId",
        "kind"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress": {
      "title": "JobProgress",
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "done",
        "total"
      ]
    },
    "info": {
      "title": "JobInfo",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "result": {
          "description": "The job's result (see the starting method's `jobResult`) once succeeded."
        },
        "error": {
          "$ref": "../common/error.schema.json"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "UTC timestamp, ISO 8601."
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "UTC timestamp, ISO 8601."
        }
      },
      "required": [
        "jobId",
        "kind",
        "state",
        "startedAt",
        "finishedAt"
      ]
    }
  }
}
