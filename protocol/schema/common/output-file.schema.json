{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/common/output-file.schema.json",
  "description": "A file the agent wrote to a caller-chosen path: size, SHA-256 and record counts, so the caller can verify it before importing.",
  "title": "OutputFile",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Records per kind (NDJSON outputs)."
    }
  },
  "required": [
    "path",
    "bytes",
    "sha256"
  ]
}
