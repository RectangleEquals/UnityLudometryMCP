{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/common/instrumentation-record.schema.json",
  "description": "One recorded call of an instrumented method (hooks and traces). Captured values are shallow and as they were at call time; anything cut is a redaction stub marked `live`.",
  "title": "InstrumentationRecord",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Global record sequence."
    },
    "hookId": {
      "type": "string",
      "description": "Set for hook records."
    },
    "jobId": {
      "type": "string",
      "description": "Set for trace records."
    },
    "phase": {
      "type": "string",
      "enum": [
        "enter",
        "exit",
        "throw"
      ]
    },
    "method": {
      "$ref": "../common/anchor.schema.json"
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "realtimeUs": {
      "type": "integer",
      "minimum": 0
    },
    "threadId": {
      "type": "integer"
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "instance": {
      "$ref": "../common/value.schema.json"
    },
    "args": {
      "type": "array",
      "items": {
        "$ref": "../common/value.schema.json"
      }
    },
    "result": {
      "$ref": "../common/value.schema.json"
    },
    "exception": {
      "title": "CapturedException",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ]
    },
    "stack": {
      "type": "array",
      "items": {
        "$ref": "../common/anchor.schema.json"
      },
      "description": "Captured call stack (method anchors)."
    },
    "durationUs": {
      "type": "integer",
      "minimum": 0
    },
    "rec": {
      "type": "string",
      "description": "NDJSON record kind (`call`) when written to a trace file."
    }
  },
  "required": [
    "seq",
    "phase",
    "method",
    "frame",
    "realtimeUs",
    "threadId",
    "depth"
  ]
}
