{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RectangleEquals/UnityLudometryMCP/protocol/schema/common/warning.schema.json",
  "description": "A non-fatal note attached to a result (e.g. truncation, exploratory resolution, skipped members).",
  "title": "Warning",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ]
}
